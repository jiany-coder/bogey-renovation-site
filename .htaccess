# Bogey Rénovation, hébergement Apache OVH
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
RewriteEngine On
# HTTPS force + www vers non-www
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Anciennes URLs
RewriteRule ^zones/(amfreville-la-campagne|elbeuf-sur-andelle|freneuse|fresne-le-plan|gouy|grand-bourgtheroulde|la-neuville-chant-doisel|le-buquet|les-essarts|montmain|quevreville-la-poterie|saint-adrien|saint-pierre-des-fleurs)(/.*)?$ /zones/ [R=301,L]
RewriteRule ^cgv/?$ /mentions-legales/ [R=301,L]
RewriteRule ^cookies/?$ /confidentialite/ [R=301,L]
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
